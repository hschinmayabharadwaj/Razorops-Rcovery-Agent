@page "/recovery"
@using GatewayUI.Models
@using GatewayUI.Services
@using GatewayUI.Components.Shared
@inject AuditStreamService Stream
@inject IGatewayApi Api
@implements IAsyncDisposable

<PageTitle>Recovery Progress</PageTitle>

<div class="container mt-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <h3 class="mb-0">Recovery Progress</h3>
        <span class="badge @StatusBadgeClass">@StatusText</span>
    </div>

    <ViewState T="RecoveryProgressDto" Result="_result" Loading="@(_result is null)">
        @if (_result!.Data is { } p)
        {
            var recovered = p.Bucket("recovered");
            var escalated = p.Bucket("escalated");
            var abandoned = p.Bucket("abandoned");
            var suppressed = p.Bucket("suppressed");
            var inFlight = p.Bucket("in_flight");

            @if (p.TotalAtRiskRupees > 0)
            {
                <div class="card mb-4">
                    <div class="card-body text-center py-4">
                        <h1 class="display-4 fw-bold mb-0" style="color: #198754;">
                            @Fmt.Rupees(recovered.Rupees) <span class="text-muted fs-5 fw-normal">of @Fmt.Rupees(p.TotalAtRiskRupees)</span>
                        </h1>
                        <p class="text-muted mb-3">at-risk recovered so far</p>

                        <div class="progress" style="height: 28px; border-radius: 14px; overflow: hidden;">
                            <div class="progress-bar bg-success" style="width: @Width(recovered, p)" title="Recovered">@Share(recovered, p)</div>
                            <div class="progress-bar bg-warning" style="width: @Width(escalated, p)" title="Escalated"></div>
                            <div class="progress-bar bg-danger" style="width: @Width(abandoned, p)" title="Abandoned"></div>
                            <div class="progress-bar bg-secondary" style="width: @Width(suppressed, p)" title="Suppressed"></div>
                            <div class="progress-bar bg-info" style="width: @Width(inFlight, p)" title="In flight"></div>
                        </div>
                        <div class="d-flex justify-content-between mt-2 small text-muted">
                            <span><i class="bi bi-circle-fill text-success"></i> Recovered</span>
                            <span><i class="bi bi-circle-fill text-warning"></i> Escalated</span>
                            <span><i class="bi bi-circle-fill text-danger"></i> Abandoned</span>
                            <span><i class="bi bi-circle-fill text-secondary"></i> Suppressed</span>
                            <span><i class="bi bi-circle-fill text-info"></i> In flight</span>
                        </div>
                    </div>
                </div>
            }

            <div class="row g-3 mb-4">
                @foreach (var (label, bucket, css) in new[]
                {
                    ("Recovered", recovered, "success"),
                    ("Escalated", escalated, "warning"),
                    ("Abandoned", abandoned, "danger"),
                    ("Suppressed", suppressed, "secondary"),
                })
                {
                    <div class="col-md-3">
                        <div class="card border-@css h-100">
                            <div class="card-body text-center">
                                <h6 class="card-subtitle mb-1 text-muted">@label</h6>
                                <h3 class="card-title text-@css mb-0">@bucket.Count</h3>
                                <small class="text-muted">@Fmt.Rupees(bucket.Rupees)</small>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (inFlight.Count > 0)
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <h6 class="text-muted mb-2">In-flight funnel</h6>
                        <div class="d-flex gap-3 flex-wrap">
                            @foreach (var (state, count) in (p.InFlightStates ?? new()).OrderBy(kv => kv.Key))
                            {
                                <span class="badge bg-info text-dark fs-6">@Fmt.Words(state): @count</span>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="text-center text-muted small">
                @p.TotalEvents events tracked · Recovery rate: @Share(recovered, p) · computed by the Go engine
            </div>
        }
    </ViewState>
</div>

@code {
    // Coalesce bursts of stream events into one refresh.
    private static readonly TimeSpan RefreshDebounce = TimeSpan.FromMilliseconds(500);

    private ApiResult<RecoveryProgressDto>? _result;
    private long _subId = -1;
    private int _refreshQueued;
    private bool _disposed;

    private string StatusText = "connecting";
    private string StatusBadgeClass = "bg-secondary";

    protected override async Task OnInitializedAsync()
    {
        Stream.StatusChanged += OnStatus;
        // StatusChanged only fires on a transition; show the current state now.
        OnStatus(Stream.CurrentStatus);
        Api.RoleChanged += OnRoleChanged;
        _result = await Api.GetRecoveryProgressAsync();
        // The stream replays history on subscribe; the debounce turns that
        // replay into at most one extra refresh.
        _subId = Stream.Subscribe(OnStreamEvent);
    }

    private void OnStatus(StreamStatus status)
    {
        InvokeAsync(() =>
        {
            StatusText = status.Phase switch
            {
                StreamPhase.Connected => "connected — tracking recovery live",
                StreamPhase.Connecting => "connecting…",
                StreamPhase.Denied => "insufficient permissions",
                StreamPhase.Reconnecting => "reconnecting…",
                _ => status.Detail
            };
            StatusBadgeClass = status.Phase switch
            {
                StreamPhase.Connected => "bg-success",
                StreamPhase.Denied => "bg-warning text-dark",
                _ => "bg-secondary"
            };
            StateHasChanged();
        });
    }

    private void OnRoleChanged() => QueueRefresh();

    private void OnStreamEvent(StreamEvent ev)
    {
        if (ev is AuditStreamEvent)
        {
            QueueRefresh();
        }
    }

    private void QueueRefresh()
    {
        if (Interlocked.Exchange(ref _refreshQueued, 1) == 1)
        {
            return;
        }
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(RefreshDebounce);
            Interlocked.Exchange(ref _refreshQueued, 0);
            if (_disposed)
            {
                return;
            }
            var fresh = await Api.GetRecoveryProgressAsync();
            // Keep showing the last good numbers through a transient failure.
            if (fresh.Ok || _result is not { Ok: true })
            {
                _result = fresh;
            }
            StateHasChanged();
        });
    }

    private static string Width(ProgressBucketDto bucket, RecoveryProgressDto p) =>
        (p.TotalAtRiskRupees > 0 ? bucket.Rupees / p.TotalAtRiskRupees * 100 : 0)
            .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%";

    private static string Share(ProgressBucketDto bucket, RecoveryProgressDto p) =>
        Fmt.Pct(p.TotalAtRiskRupees > 0 ? bucket.Rupees / p.TotalAtRiskRupees : 0);

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        Stream.StatusChanged -= OnStatus;
        Api.RoleChanged -= OnRoleChanged;
        if (_subId >= 0)
        {
            Stream.Unsubscribe(_subId);
        }
        return ValueTask.CompletedTask;
    }
}
